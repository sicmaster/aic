PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://sa:Center%40123@localhost:5432/aic
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSION_COOKIE_NAME=aic_session
AUTH_SESSION_TTL_DAYS=7
AUTH_LOCK_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=aic:dev
JWT_SECRET=change-me

# Optional first admin seed. Use a local secret manager or uncommitted .env.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=change-this-to-at-least-12-chars
# INITIAL_ADMIN_FULL_NAME=System Admin
# INITIAL_ADMIN_RESET_PASSWORD=false
